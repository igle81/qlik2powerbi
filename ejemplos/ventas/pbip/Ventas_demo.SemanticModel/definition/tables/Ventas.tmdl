		summarizeBy: none
		sourceColumn: Estado

		annotation SummarizationSetBy = Automatic

	partition Ventas = m
		mode: import
		source =
			let
			    Origen = Csv.Document(File.Contents(CarpetaDatos & "/ventas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
			    Tipos = Table.TransformColumnTypes(Encabezados, {{"PedidoID", Int64.Type}, {"Fecha", type date}, {"ClienteID", Int64.Type}, {"ProductoID", Int64.Type}, {"Cantidad", Int64.Type}, {"Importe", type number}, {"Alto", type text}, {"Normal", type text}}),
			    Filtrar = Table.SelectRows(Tipos, each [Cantidad] > 0),
			    Calcular = Table.AddColumn(Filtrar, "Anio", each Date.Year([Fecha]), Int64.Type),
			    Calcular2 = Table.AddColumn(Calcular, "Mes", each Date.Month([Fecha]), Int64.Type),
			    Calcular3 = Table.AddColumn(Calcular2, "Segmento", each if [Importe] > 1000 then "Alto" else "Normal", type text),
			    Seleccionar = Table.SelectColumns(Calcular3, {"PedidoID", "Fecha", "Anio", "Mes", "ClienteID", "ProductoID", "Cantidad", "Importe", "Segmento"}),
			    Unir = Table.NestedJoin(Seleccionar, {"PedidoID"}, (
			    let
			        Origen = VentasSQL,
			        Seleccionar = Table.SelectColumns(Origen, {"PedidoID", "Estado"})
			    in
			        Seleccionar
			    ), {"PedidoID"}, "union_qlik", JoinKind.LeftOuter),
			    ExpandirUnion = Table.ExpandTableColumn(Unir, "union_qlik", {"Estado"}, {"Estado"})
			in
			    ExpandirUnion

	annotation PBI_ResultType = Table
