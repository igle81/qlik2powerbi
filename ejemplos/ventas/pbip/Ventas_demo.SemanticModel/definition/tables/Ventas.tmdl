table Ventas
	lineageTag: b88d11b6-67e4-5dad-a0f0-83a3bb3c237e

	measure 'Importe total' = SUM('Ventas'[Importe])
		formatString: #,0.00
		displayFolder: Medidas
		lineageTag: bcc2dc62-656e-5b60-9789-687106136753

	measure Pedidos = DISTINCTCOUNT('Ventas'[PedidoID])
		formatString: #,0
		displayFolder: Medidas
		lineageTag: 80550c45-b2df-5ace-8175-8e1f239cf696

	measure 'Importe 2024' = CALCULATE(SUM('Ventas'[Importe]), 'Ventas'[Anio] = 2024)
		formatString: #,0.00
		displayFolder: Medidas
		lineageTag: a263a615-4303-5a94-9c13-f9b91f89a82c

	measure 'Ticket medio' = IF(DISTINCTCOUNT('Ventas'[PedidoID]) > 0, SUM('Ventas'[Importe]) / DISTINCTCOUNT('Ventas'[PedidoID]), 0)
		formatString: #,0.00
		displayFolder: Medidas
		lineageTag: 1eec60e6-ffce-5b05-872b-ca9a5060437e

	measure 'Importe por cliente' = SUMX(VALUES('Clientes'[Cliente]), CALCULATE(SUM('Ventas'[Importe])))
		formatString: #,0.00
		displayFolder: Medidas
		lineageTag: 5ff12816-2b0a-5714-a12a-87c94cfd6f95

	measure 'Importe sin año' = CALCULATE(SUM('Ventas'[Importe]), REMOVEFILTERS('Ventas'[Anio]))
		formatString: #,0.00
		displayFolder: Medidas
		lineageTag: 3ad5359a-2d16-52cd-a001-b8aea273de2c

	measure 'Importe del variable' = SUM('Ventas'[Importe])
		formatString: #,0.00
		displayFolder: Medidas
		lineageTag: 1b35fe71-528d-5e35-9cd6-142828e57013

	measure 'Mes anterior' = /* REVISAR: Above(Sum(Importe)) */ BLANK()
		formatString: #,0.00
		displayFolder: Medidas
		lineageTag: 78ba6248-6b23-535e-9333-d5bba6d521bb

